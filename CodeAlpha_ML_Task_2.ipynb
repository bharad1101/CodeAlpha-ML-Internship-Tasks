        "!pip install librosa scikit-learn\n",
        "\n",
        "import librosa\n",
        "import numpy as np\n",
        "\n",
        "audio_path = librosa.ex('trumpet')\n",
        "\n",
        "y, sr = librosa.load(audio_path)\n",
        "\n",
        "mfccs = librosa.feature.mfcc(y=y, sr=sr, n_mfcc=13)\n",
        "\n",
        "print(\"MFCC Features Extracted\")\n",
        "print(mfccs.shape)"
      ]
    }
